# Example portfolio sizing — copy to .env.local and customize.
# Both values are interpreted as USD whole dollars.

CAPITAL=100000
CASH_BUFFER=20000

# Optional: near-real-time catalyst news for the Ross Screener.
# Get a free key at https://finnhub.io/register (free tier includes company-news).
# When set, the screener merges Finnhub's minute-level breaking headlines with
# Yahoo. When unset, it falls back to Yahoo only — no other change.
# FINNHUB_API_KEY=your_finnhub_api_key_here
